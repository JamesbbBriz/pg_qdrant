# P0 build/test environment. This is not a production database image.
FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS build-tools

ARG DEBIAN_FRONTEND=noninteractive
ARG RUSTUP_SHA256=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71

# The minimal base has no CA bundle. Bootstrap only public roots from a package
# whose checksum is anchored in the reviewed signed Ubuntu snapshot metadata.
# BuildKit downloads this over verified TLS; no APT/TLS checks are disabled.
ADD --checksum=sha256:6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50 \
    https://snapshot.ubuntu.com/ubuntu/20261008T061600Z/pool/main/c/ca-certificates/ca-certificates_20260601~24.04.1_all.deb \
    /tmp/pgq-bootstrap-ca.deb
COPY packaging/native/ /opt/pg_qdrant_native/
COPY scripts/verify_native.py /opt/pg_qdrant_native/verify_native.py
RUN test "$(dpkg --print-architecture)" = amd64 \
    && mkdir -p /tmp/pgq-bootstrap-roots /etc/ssl/certs \
    && dpkg-deb --extract /tmp/pgq-bootstrap-ca.deb /tmp/pgq-bootstrap-roots \
    && cat /tmp/pgq-bootstrap-roots/usr/share/ca-certificates/mozilla/*.crt \
       >/etc/ssl/certs/ca-certificates.crt \
    && rm -rf /tmp/pgq-bootstrap-ca.deb /tmp/pgq-bootstrap-roots \
    && rm -f /etc/apt/sources.list \
    && rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources \
    && cp /opt/pg_qdrant_native/ubuntu.sources /etc/apt/sources.list.d/ubuntu.sources \
    && cp /opt/pg_qdrant_native/99-pg-qdrant-freeze /etc/apt/apt.conf.d/99-pg-qdrant-freeze \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg build-essential pkg-config cmake python3 \
    libssl-dev libreadline-dev zlib1g-dev libxml2-dev libxslt1-dev libicu-dev \
    flex bison locales util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN cp /opt/pg_qdrant_native/postgresql.asc /usr/share/keyrings/postgresql.asc \
    && cp /opt/pg_qdrant_native/pgdg.sources /etc/apt/sources.list.d/pgdg.sources \
    && cp /opt/pg_qdrant_native/pgdg.pref /etc/apt/preferences.d/pg-qdrant-pgdg.pref \
    && apt-get update \
    && xargs -r -a /opt/pg_qdrant_native/pgdg-packages.txt \
       apt-get install -y --no-install-recommends --download-only \
    && python3 /opt/pg_qdrant_native/verify_native.py archives \
       --manifest /opt/pg_qdrant_native/pgdg-packages.json --cache /var/cache/apt/archives \
       >/opt/pg_qdrant_native/verified-pgdg-archives.json \
    && xargs -r -a /opt/pg_qdrant_native/pgdg-packages.txt \
       apt-get install -y --no-install-recommends --no-download \
    && rm -rf /var/lib/apt/lists/*

ENV CARGO_HOME=/opt/cargo RUSTUP_HOME=/opt/rustup
ENV PATH=/opt/cargo/bin:/usr/lib/postgresql/17/bin:${PATH}
ENV PGRX_PG_CONFIG_PATH=/usr/lib/postgresql/17/bin/pg_config
ENV CARGO_BUILD_JOBS=2 CARGO_HTTP_MULTIPLEXING=false

RUN curl --fail --silent --show-error \
    https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init \
    -o /tmp/rustup-init \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum --check \
    && chmod 755 /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain 1.96.0 --no-modify-path \
    && rustup component add rustfmt clippy \
    && rm /tmp/rustup-init
RUN cargo install cargo-pgrx --version 0.19.3 --locked

FROM build-tools AS verification
WORKDIR /src
COPY . .
RUN cargo fmt --all -- --check \
    && python3 scripts/dependency_report.py --comparison-output docs/dependency-profiles.json --check \
    && cargo test --locked -p pg-qdrant-protocol \
    && cargo run --locked -p pg-qdrant-edge-probe -- --cpu-check >/tmp/cpu-admission.json \
    && cargo test --locked -p pg-qdrant-edge-probe -- --test-threads=1 \
    && cargo test --locked -p pg-qdrant-helper --test supervisor_child \
    && cargo test --locked -p pg-qdrant-helper --bin pg_qdrant_p0_helper \
    && cargo run --locked -p pg-qdrant-edge-probe >/tmp/edge-probe.json

# Fault injection and the helper comparison are explicit P0-only image choices.
ARG P0_FAULTS=0
ARG P0_HELPER=0
RUN pgq_features=pg17 \
    && if [ "${P0_FAULTS}" = 1 ]; then \
         pgq_features="${pgq_features} p0-fault-injection" \
         && cargo test --locked -p pg-qdrant-edge-probe \
           --features p0-fault-injection --lib oom_probe::tests; \
       fi \
    && if [ "${P0_HELPER}" = 1 ]; then \
         pgq_features="${pgq_features} p0-managed-helper"; \
         if [ "${P0_FAULTS}" = 1 ]; then \
           cargo build --locked -p pg-qdrant-helper --features p0-fault-injection; \
         else \
           cargo build --locked -p pg-qdrant-helper; \
         fi \
         && install -m 755 target/debug/pg_qdrant_p0_helper \
           "$("${PGRX_PG_CONFIG_PATH}" --bindir)/pg_qdrant_p0_helper"; \
       fi \
    && cargo pgrx install --manifest-path crates/pg_qdrant/Cargo.toml \
         --no-default-features --features "${pgq_features}" \
         --pg-config "${PGRX_PG_CONFIG_PATH}" --cargo=--locked
ENV PG_QDRANT_MANAGED_HELPER=${P0_HELPER}
RUN mkdir -p /src/artifacts \
    && target/debug/pg-qdrant-edge-probe --cpu-check >/src/artifacts/cpu-admission.json \
    && python3 scripts/check_native_cpu.py >/src/artifacts/native-cpu-objects.json \
    && dpkg-query -W -f='${binary:Package}\t${Version}\n' >/src/artifacts/native-packages.tsv \
    && python3 /opt/pg_qdrant_native/verify_native.py installed \
       --expected /opt/pg_qdrant_native/expected-installed.tsv \
       --observed /src/artifacts/native-packages.tsv \
       >/src/artifacts/native-inventory-verification.json \
    && cp /opt/pg_qdrant_native/verified-pgdg-archives.json /src/artifacts/ \
    && set -- --expected-packages /opt/pg_qdrant_native/expected-installed.tsv \
       --pg-config "${PGRX_PG_CONFIG_PATH}" \
       --extension "$("${PGRX_PG_CONFIG_PATH}" --pkglibdir)/pg_qdrant.so" \
       --out /src/artifacts/native-build-report.json \
    && pgq_profile=direct \
    && if [ "${P0_HELPER}" = 1 ]; then \
         pgq_profile=helper; \
         set -- "$@" --helper "$("${PGRX_PG_CONFIG_PATH}" --bindir)/pg_qdrant_p0_helper"; \
       fi \
    && if [ "${P0_FAULTS}" = 1 ]; then pgq_profile="${pgq_profile}-fault"; fi \
    && for pgq_trace in target/debug/build/pgrx-pg-sys-*/stderr; do \
         if [ -f "${pgq_trace}" ]; then set -- "$@" --pgrx-build-stderr "${pgq_trace}"; fi; \
       done \
    && for pgq_binding in target/debug/build/pgrx-pg-sys-*/out/pg17.rs; do \
         if [ -f "${pgq_binding}" ]; then set -- "$@" --bindings-artifact "${pgq_binding}"; fi; \
       done \
    && python3 scripts/native_build_report.py "$@" --profile "${pgq_profile}" \
    && useradd --create-home --uid 10001 builder \
    && chown builder:builder /src/artifacts
USER builder
ENV PG_QDRANT_ARTIFACT_DIR=/src/artifacts
ARG PG_QDRANT_SOURCE_SHA=unrecorded
ENV PG_QDRANT_SOURCE_SHA=${PG_QDRANT_SOURCE_SHA}
CMD ["bash", "crates/pg_qdrant/tests/run-p0.sh"]
